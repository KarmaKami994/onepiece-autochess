# Public origin at the browser, without a path or trailing slash.
MULTIPLAYER_PUBLIC_ORIGIN=http://localhost:3000
# Keep these three ports distinct and local to the server.
MULTIPLAYER_GATEWAY_PORT=3000
MULTIPLAYER_WEB_PORT=3100
MULTIPLAYER_ROOM_PORT=3101
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BETTER_AUTH_SECRET=
MULTIPLAYER_AUTH_DB=.codex-local/multiplayer-auth.sqlite
MULTIPLAYER_VOYAGE_DB=.codex-local/multiplayer-voyage.sqlite
MULTIPLAYER_FRIENDS_FILE=.codex-local/multiplayer-friends.json

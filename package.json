{
  "name": "grand-line-auto-chess",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "assets:carousel": "node scripts/build_carousel_assets.mjs",
    "assets:maps": "node scripts/build_board_maps.mjs",
    "assets:luffy": "node scripts/build_character_animation.mjs --character luffy",
    "assets:luffy:v2": "node scripts/build_v2_assets.mjs --asset luffy --skip-editable",
    "assets:zoro": "node scripts/build_character_animation.mjs --character zoro",
    "assets:nami": "node scripts/build_character_animation.mjs --character nami",
    "assets:chopper": "node scripts/build_character_animation.mjs --character chopper",
    "assets:character": "node scripts/build_character_animation.mjs",
    "assets:roster": "node scripts/build_character_animation.mjs --roster",
    "assets:v2": "node scripts/build_v2_assets.mjs --skip-editable",
    "assets:v2:editable": "node scripts/build_v2_assets.mjs",
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "vitest run --config vitest.config.ts --exclude tests/soak.test.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:soak": "vitest run --config vitest.config.ts tests/soak.test.ts",
    "test:production-smoke": "tsx scripts/run_production_soak.ts --seeds=50 --out=tmp/production-smoke-report.json",
    "test:production-soak": "tsx scripts/run_production_soak.ts --seeds=1000 --out=tmp/production-soak-report.json",
    "test:coverage": "vitest run --config vitest.config.ts --exclude tests/soak.test.ts --coverage",
    "assets:validate": "node scripts/validate_assets.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "next": "16.3.2",
    "phaser": "4.2.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "sharp": "0.34.5",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "vitest": "^4.1.10"
  },
  "type": "module"
}
